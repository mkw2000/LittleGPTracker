	<MAP src="but:0:6" dst="/event/start" />
	<MAP src="but:0:9" dst="/event/lshoulder" />
	<MAP src="but:0:10" dst="/event/rshoulder" />
	<MAP src="but:0:11" dst="/event/up" />
	<MAP src="but:0:12" dst="/event/down" />
